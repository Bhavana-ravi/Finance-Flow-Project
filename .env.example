# Copy this file to .env and replace each value for your machine.
# This is Prisma's equivalent of Spring Boot's spring.datasource configuration.
PORT=5000
# PostgreSQL connection: the final segment is the database name (FinanceFlowDB in this example).
DATABASE_URL=postgresql://postgres:root@localhost:5432/financeflow
# Prisma uses its schema automatically; `npm run db:setup --prefix server` creates the tables.
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
